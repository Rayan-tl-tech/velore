# Server Port
PORT=5000

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/velor?retryWrites=true&w=majority

# Target Database Name (Strict environment isolation)
# - Development: uses 'velor_dev' by default if unset
# - Test: strictly isolated to 'velor_test' (cannot be overridden)
# - Production: strictly requires explicit DB_NAME=velor (server startup fails if missing or incorrect)
DB_NAME=velor

# JWT Secret Key for token signing (Provide a long, random string in production)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary Image Storage (MANDATORY in production; optional fallback to /uploads in development)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend Production URL for CORS and CSRF Protection (e.g. deployed Vercel domain)
FRONTEND_URL=https://votre-frontend.vercel.app

