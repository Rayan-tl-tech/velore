        {
          "name": "3.3 Update Cart Item Quantity",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Quantity updated\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var item = jsonData.items.find(i => (i.product._id || i.product) === pm.collectionVariables.get(\"productId\"));",
                  "    pm.expect(item.quantity).to.eql(4);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
