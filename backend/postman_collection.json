            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Order contains items and totalPrice\", function () {",
                  "    pm.expect(jsonData).to.have.property('_id');",
                  "    pm.expect(jsonData).to.have.property('totalPrice');",
                  "    pm.expect(jsonData.items.length).to.be.above(0);",
                  "});",
                  "if (jsonData._id) {",
                  "    pm.collectionVariables.set(\"orderId\", jsonData._id);",
                  "    console.log(\"Saved orderId:\", jsonData._id);",
